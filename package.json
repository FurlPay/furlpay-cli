{
  "name": "@furlpay/cli",
  "version": "0.4.0",
  "description": "FurlPay CLI: Institutional x402 v2 payment facilitation, mainnet CLOB market data, and autonomous agent settlement infrastructure",
  "author": "FurlPay <engineering@furlpay.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FurlPay/furlpay-cli.git"
  },
  "homepage": "https://furlpay.io",
  "keywords": [
    "furlpay",
    "x402",
    "stablecoin",
    "payments",
    "settlement",
    "CLOB",
    "orderbook",
    "hyperliquid",
    "usdc",
    "agent",
    "micropayment",
    "fintech",
    "DeFi",
    "tokenization",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "furlpay": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "lib",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "benchmark": "node dist/cli.js benchmark",
    "clean": "rimraf dist",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "conf": "^13.0.1",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "inquirer": "^12.2.0",
    "ora": "^8.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
