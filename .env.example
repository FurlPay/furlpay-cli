# FurlPay CLI environment variables (2026-11-17 gap-closure)
#
# Copy to `.env` — the CLI loads it via dotenv from the working directory.
# NEVER commit a real `.env`. Secrets in env vars, never in config.toml.

# ── Hyperliquid (live perp execution / HLP vault) ─────────────────────────
# EIP-712 signing key (API wallet recommended over master key).
# HYPERLIQUID_PRIVATE_KEY=0x...
# Alias honored by the same code path:
# ETH_PRIVATE_KEY=0x...
# Set to 1 to target api.hyperliquid-testnet.xyz.
# FURLPAY_HL_TESTNET=0

# USDC/USD peg feed for the pre-trade depeg guardrail. Defaults to CoinGecko's
# simple price; point it at any https endpoint answering the same shape
# { "usd-coin": { "usd": <number> } } (self-hosted oracle aggregator). The
# risk engine refreshes it at most once per 30s; a failed feed is surfaced as
# an explicit PEG_FEED_UNAVAILABLE warning on every order — never a synthetic
# price, and a depeg halt already in force stays until real data proves
# recovery. HTTPS only.
# FURLPAY_USDC_PEG_FEED_URL=

# ── Binance (spot; testnet is the default) ────────────────────────────────
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# Exact string "mainnet" opts into api.binance.com — everything else stays
# on testnet.binance.vision.
# FURLPAY_BINANCE_ENV=testnet

# ── RPC endpoints (public defaults; point at your own provider) ──────────
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# ETHEREUM_RPC_URL=https://cloudflare-eth.com
# BASE_RPC_URL=https://mainnet.base.org
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# ── Oracle gateway (furlpay oracle / MCP furlpay_oracle_price) ───────────
# The default sources are public and keyless (Coinbase, Kraken, Binance,
# Jupiter). The Pyth Hermes provider is INACTIVE unless you supply a gateway
# you are authorized to use plus your verified feed IDs (JSON, symbol → id):
# FURLPAY_PYTH_HERMES_URL=https://your-pyth-gateway.example
# FURLPAY_PYTH_FEED_IDS={"SOL":"0xef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d"}

# ── Jupiter (furlpay solana price/quote — public Lite API default) ───────
# FURLPAY_JUPITER_API_URL=https://lite-api.jup.ag

# ── AI assistant (support chat engine) ───────────────────────────────────
# ANTHROPIC_API_KEY=

# ── Behavior flags ────────────────────────────────────────────────────────
# FURLPAY_NO_BROWSER=1        # device auth: print URL instead of opening
# FURLPAY_QUIET_TRUST_WARNING=1
